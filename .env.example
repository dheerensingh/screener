# ── Email (Gmail) ────────────────────────────────────────────────────────────
# The Gmail address the bot sends FROM.
SENDER_EMAIL=yourbot@gmail.com

# A 16-character Google App Password — NOT your Gmail login password.
# Generate at: myaccount.google.com → Security → 2-Step Verification → App Passwords
SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx

# The address to receive the daily email (can be the same as SENDER_EMAIL).
RECEIVER_EMAIL=you@example.com

# ── Trading account / position sizing (optional — both have code defaults) ───
# Total trading capital used for position-size calculations.
TRADING_ACCOUNT_SIZE=500000

# % of the account risked on any single trade (fixed-fractional sizing).
RISK_PCT_PER_TRADE=1.0

# ── GitHub Pages (optional) ───────────────────────────────────────────────────
# Base URL of the published report site, e.g. https://<user>.github.io/<repo>
# Used to build the "View full report" link in the summary email.
# Leave blank locally; set as a repo secret for the GitHub Actions run.
PAGES_BASE_URL=
